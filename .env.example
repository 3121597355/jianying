# 可选公开部署变量。启动脚本不会自动读取 .env，请由运行环境注入。
# BIND_HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-domain.example
# 通过 npm run start:public 启用公开模式。不要在此填写 API 密钥。

# Vercel 生产环境：通过部署平台注入，不在仓库中填写真实值。
# DATABASE_URL=postgresql://...
# ADMIN_SETUP_CODE=<independent-random-setup-code>
# PORTRAIT_REQUEST_SECRET=<independent-random-request-secret>
