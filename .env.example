# 可选公开部署变量。启动脚本不会自动读取 .env，请由运行环境注入。
# BIND_HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-domain.example
# PUBLIC_ALTERNATE_ORIGINS=https://your-project.vercel.app
# 搜索平台的公开 meta 验证值，按实际站长平台生成值填写；不是登录密码。
# GOOGLE_SITE_VERIFICATION=your-verification-token
# BING_SITE_VERIFICATION=your-verification-token
# BAIDU_SITE_VERIFICATION=your-verification-token
# 通过 npm run start:public 启用公开模式。不要在此填写 API 密钥。

# Vercel 生产环境：通过部署平台注入，不在仓库中填写真实值。
# DATABASE_URL=postgresql://...
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<unique-long-initial-password>
# PORTRAIT_REQUEST_SECRET=<independent-random-request-secret>
# MAINTENANCE_MODE=1  # 全站关站；filing 只开放 PUBLIC_ORIGIN 和当前 Vercel 部署域名

# 简历文本 AI 的独立服务端配置；前期免费，未配置时只提供基础整理。
# 也可在管理员“账户与简历”中保存，管理员保存值优先。
# RESUME_AI_BASE_URL=https://api.example.com/v1
# RESUME_AI_MODEL=your-text-model
# RESUME_AI_API_KEY=<dedicated-server-side-key>
# RESUME_AI_DAILY_LIMIT=3
# 本机/单进程使用 private/members；多实例或 Vercel 必须使用 DATABASE_URL。
