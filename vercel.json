{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/vercel-build.mjs",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "vercel-public",
  "regions": [
    "hkg1"
  ],
  "functions": {
    "api/server.mjs": {
      "maxDuration": 60,
      "includeFiles": "{*.html,sanitizer.bundle.cjs,changelog-seed.json,assets/**,portrait/public/**,portrait/models/*.onnx}",
      "excludeFiles": "{private/**,node_modules/onnxruntime-node/bin/napi-v6/win32/**,node_modules/onnxruntime-node/bin/napi-v6/darwin/**,node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**}"
    }
  },
  "routes": [
    {
      "src": "/(assets|portrait)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/server"
    }
  ]
}
