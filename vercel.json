{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/vercel-build.mjs",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "vercel-public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/server.mjs": {
      "maxDuration": 60,
      "includeFiles": "{*.html,changelog-seed.json,assets/**,portrait/public/**,portrait/models/*.onnx}",
      "excludeFiles": "{private/**,node_modules/onnxruntime-node/bin/napi-v6/win32/**,node_modules/onnxruntime-node/bin/napi-v6/darwin/**,node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
